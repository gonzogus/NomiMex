<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
  </startup>
  <connectionStrings>
    <!-- Servidor de pruebas. En producción use un usuario con permisos mínimos o autenticación integrada. -->
    <add name="NomiMex"
         connectionString="Data Source=SOPORTE\SQLEXPRESS;Initial Catalog=NomiMex;User ID=sa;Password=b1softPLite19;Encrypt=False;TrustServerCertificate=True;Connect Timeout=15;Application Name=NomiMex"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Clave AES-256 (32 bytes aleatorios en Base64) con la que se cifra la contraseña de los CSD.
         Genérela una sola vez y consérvela fuera del código fuente: $b=New-Object byte[] 32;[Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);[Convert]::ToBase64String($b) -->
    <add key="CsdClaveCifrado" value="T7v9X8aN2+L5mQ1/E4pW9zY4/D6bA3+T5/C2+M1v8Qc=" />

    <!-- Servicio SMTP para el envío de códigos de recuperación de contraseña.
         No deje credenciales reales en el repositorio: use variables de entorno o un
         App.config local protegido en producción. -->
    <add key="Smtp.Host" value="smtp.office365.com" />
    <add key="Smtp.Puerto" value="587" />
    <add key="Smtp.Ssl" value="true" />
    <add key="Smtp.Usuario" value="no-responder@nomimex.local" />
    <add key="Smtp.Password" value="" />
    <add key="Smtp.Remitente" value="no-responder@nomimex.local" />
    <add key="Smtp.RemitenteNombre" value="NomiMex" />
    <add key="Smtp.TimeoutMs" value="30000" />
  </appSettings>
</configuration>
